FROM rust:bookworm AS builder
WORKDIR /app

# Cache dependency compilation separately from source.
# Must stub BOTH targets: binary and the auto-detected lib (src/lib.rs).
# rust:bookworm (not slim) has the full C toolchain rusqlite bundled needs.
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src/bin \
    && echo 'fn main(){}' > src/bin/main.rs \
    && echo '' > src/lib.rs
RUN cargo build --release

# Build real binary — touch forces cargo to re-link against real source
COPY src ./src
RUN touch src/lib.rs src/bin/main.rs && cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/server .
CMD ["./server"]
