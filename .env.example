# --- Rust API ---
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/postgres
SOLANA_RPC_URL=http://127.0.0.1:8899
# SOLANA_KEYPAIR_PATH=./fee_payer.json   # dev only; production uses KMS/HSM
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
PYTHON_ENGINE_URL=http://127.0.0.1:8001
INSTITUTION_NAME=Demo University
# EDITOR_EMAILS=editor@university.edu     # first user to sign in is editor anyway
# GROQ_API_KEY=                           # optional: LLM metadata extraction (falls back to rules)
LLM_MODEL=openai/gpt-oss-20b     # fast; use openai/gpt-oss-120b for richer abstracts. Must be a model your key can access.
SIMILARITY_THRESHOLD=0.82
PUBLIC_BASE_URL=http://127.0.0.1:5000

# --- Python vector service ---
EMBEDDING_PROVIDER=local        # local | groq | fake
EMBEDDING_MODEL=all-MiniLM-L6-v2   # production: BAAI/bge-m3 (set EMBEDDING_DIM=1024)
EMBEDDING_DIM=384
QDRANT_URL=http://127.0.0.1:6333
